# Every setting can be given with the project prefix D365_SolAna_ (preferred, avoids clashes with other apps in the
# same Vercel team) or with the plain name shown in brackets. The prefixed name wins if both are set.

# Supabase project (public values: the anon/publishable key is protected by row-level security).
# [NEXT_PUBLIC_SUPABASE_URL]
D365_SolAna_SUPABASE_URL=
# [NEXT_PUBLIC_SUPABASE_ANON_KEY]   Never use the service_role / secret key here.
D365_SolAna_SUPABASE_ANON_KEY=

# REQUIRED, server-only. 32-byte key used to encrypt everything stored in Supabase.  [DATA_ENCRYPTION_KEY]
# Generate:  echo "k1:$(openssl rand -base64 32)"
# Losing this key makes stored data unrecoverable; keep a copy in your secrets manager.
D365_SolAna_DATA_ENCRYPTION_KEY=

# Rotation: put the new key in the variable above and move the old one(s) here (comma-separated "<id>:<base64>").
# [DATA_ENCRYPTION_KEYS_PREVIOUS]
D365_SolAna_DATA_ENCRYPTION_KEYS_PREVIOUS=

# Optional: comma-separated emails allowed to use the app (everyone else gets 403). Recommended.  [ALLOWED_EMAILS]
D365_SolAna_ALLOWED_EMAILS=
