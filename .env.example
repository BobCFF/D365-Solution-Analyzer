# Supabase (public values; safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED, server-only. 32-byte key used to encrypt everything stored in Supabase.
# Generate:  echo "k1:$(openssl rand -base64 32)"
# Losing this key makes stored data unrecoverable; keep a copy in your secrets manager.
DATA_ENCRYPTION_KEY=

# Rotation: put the new key in DATA_ENCRYPTION_KEY and move the old one(s) here (comma-separated "<id>:<base64>").
DATA_ENCRYPTION_KEYS_PREVIOUS=

# Optional: comma-separated emails allowed to use the app (everyone else gets 403). Recommended for private deployments.
ALLOWED_EMAILS=
